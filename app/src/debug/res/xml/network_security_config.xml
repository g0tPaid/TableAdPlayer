<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug builds may talk to a LAN mock API over HTTP. Release forbids cleartext. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
